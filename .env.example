PORT=3100
# LOCAL ejemplo:
DATABASE_URL=postgresql://postgres:CAMBIAR_CLAVE@127.0.0.1:5432/alepi_business_dev
# Para PostgreSQL cloud/Supabase, reemplaza DATABASE_URL por la cadena de conexión correspondiente.
# Si el proveedor exige SSL, usa:
DB_SSL=false
# Tras migrar y activar todos los dispositivos, mantener true en produccion.
# El instalador deja false temporalmente mientras se actualizan los celulares.
COMMERCIAL_AUTH_STRICT=true
